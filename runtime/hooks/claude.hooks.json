{
  "hooks": {
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "python3 /opt/z8/hooks/z8_event.py --provider claude", "timeout": 2}]}
    ],
    "PreToolUse": [
      {"matcher": "^(AskUserQuestion|ExitPlanMode)$", "hooks": [{"type": "command", "command": "python3 /opt/z8/hooks/z8_event.py --provider claude", "timeout": 2}]}
    ],
    "Notification": [
      {"matcher": "^(elicitation_dialog|elicitation_url_dialog)$", "hooks": [{"type": "command", "command": "python3 /opt/z8/hooks/z8_event.py --provider claude", "timeout": 2}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 /opt/z8/hooks/z8_event.py --provider claude", "timeout": 2}]}
    ]
  }
}
